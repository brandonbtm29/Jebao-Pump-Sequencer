# Normalize text files to LF in the repo; Git converts on checkout where noted.
* text=auto

# Windows scripts need CRLF line endings
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# macOS/Linux scripts need LF line endings
*.command text eol=lf
*.sh      text eol=lf
*.py      text eol=lf

# Binary files
*.png     binary
*.jpg     binary
*.ico     binary
*.docx    binary
*.pdf     binary
